<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>false</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="3.5.0" />
    <PackageReference Include="KubeOps.Abstractions" Version="13.3.4" />
    <PackageReference Include="KubeOps.KubernetesClient" Version="13.3.4" />
    <PackageReference Include="KubeOps.Operator" Version="13.3.4" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.85.0" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
    <PackageReference Include="NCrontab" Version="3.4.0" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="Protos\csi.proto" GrpcServices="Server" />
  </ItemGroup>
</Project>